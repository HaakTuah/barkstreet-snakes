+      const hb = chatHead.getBoundingClientRect();
+      if (hb.height && hb.top >= free.bottom - 1 && hb.top - free.bottom < 24) {
+        free.deep = Math.min(innerHeight - inset('--safe-b'), hb.bottom) - free.bottom;
+        free.keep = [...hanging.filter(el => el.classList.contains('leaves')), chatLabel, chatToggle].map(el => el.getBoundingClientRect()).filter(f => f.width && f.bottom > b.bottom).map(f => [f.left - 6, f.right + 6]); // (standing tall it's in front of the frame's moss, as it clings to the log, but clear of the corner leaves, the chatter's name and its switch)
+      }
     }
     R.setBoardRect(b.left, b.top, b.width, free);
     fitHelp();
