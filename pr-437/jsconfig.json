// Types for the online messages, checked only (tsc --noEmit -p jsconfig.json; see
// .github/workflows/tests.yml): net.js and online.js, and what they see of the rest of
// the page in types/globals.d.ts. Nothing is built or shipped from this.
{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": []
  },
  "files": ["types/globals.d.ts", "net.js", "online.js"]
}
